mzsol.online, www.mzsol.online {
    encode gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    # Pages légales (conditions, confidentialité) rendues par Django :
    # sans cette règle, elles tombaient sur l'application React (404).
    handle /legal/* {
        reverse_proxy backend:8000
    }

    handle /media/* {
        root * /srv
        file_server
    }

    handle /static/* {
        root * /srv/staticfiles
        uri strip_prefix /static
        file_server
    }

    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
